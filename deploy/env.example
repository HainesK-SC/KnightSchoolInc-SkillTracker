# Copy to deploy/.env on the server and fill in real values.
# deploy/.env must NEVER be committed.
# Never use $ ; or quotes in a value.

# Your DuckDNS hostname, without https://
DOMAIN=your-subdomain.duckdns.org

# Where CI publishes the images: ghcr.io/<repo owner, all lowercase>/knightschool
IMAGE_PREFIX=ghcr.io/your-github-owner/knightschool

# Which image tag to run. Leave unset for the latest "dev" build;
# set to a commit SHA to roll back to that exact build.
# IMAGE_TAG=dev

# SQL Server SA password: 8+ chars with upper, lower, digit and symbol,
# or SQL Server refuses to start.
SA_PASSWORD=

# JWT signing key - generate with:  openssl rand -base64 48
JWT_KEY=

# Seeded admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

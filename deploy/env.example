# Copy to deploy/.env on the server and fill in real values.
# deploy/.env must NEVER be committed.

# Your DuckDNS hostname, without https://
DOMAIN=your-subdomain.duckdns.org

# SQL Server SA password: 8+ chars with upper, lower, digit and symbol,
# or SQL Server refuses to start. Avoid ; and quotes (they break the connection string).
SA_PASSWORD=

# JWT signing key - generate with:  openssl rand -base64 48
JWT_KEY=

# Seeded admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=

### Register: success (new random email each run)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "user-{{$guid}}@test.com",
  "password": "Passw0rd!",
  "firstName": "Kyle",
  "lastName": "Test"
}

### Register: success (fixed email to test login)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "kyle@test.com",
  "password": "MySuperSecretPassw0rd!",
  "firstName": "Kyle",
  "lastName": "Test"
}

### Register: fixed email (run twice; the second run should return 409)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "kyle@test.com",
  "password": "Passw0rd!",
  "firstName": "Kyle",
  "lastName": "Test"
}

### Register: weak password (expect 400 with Identity's password rules)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "weak@test.com",
  "password": "abc",
  "firstName": "Kyle",
  "lastName": "Test"
}

### Register: missing firstName (expect 400 validation error)
POST {{host}}/api/auth/register
Content-Type: application/json

{
  "email": "missing@test.com",
  "password": "Passw0rd!",
  "lastName": "Test"
}

### Login: success(admin)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@test.com",
  "password": "Adm1n!Passw0rd"
}

### Login: success(non-admin)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "kyle@test.com",
  "password": "MySuperSecretPassw0rd!"
}

### Login: wrong password (expect 401, generic message)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "kyle@test.com",
  "password": "WrongPass1!"
}

### Login: unknown email (expect 401, the SAME message as wrong password)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "nobody@test.com",
  "password": "Passw0rd!"
}

### Me: no cookie (expect 401 with an EMPTY body)
GET {{host}}/api/auth/me

### Me: with cookie (expect 200 with your user info)
GET {{host}}/api/auth/me
Cookie: knightschool_auth={{authCookie}}

### Me: token as Authorization header (diagnostic)
GET {{host}}/api/auth/me
Authorization: Bearer {{authCookie}}

### Logout (expect 204, and a Set-Cookie that expires the cookie)
POST {{host}}/api/auth/logout
Cookie: knightschool_auth={{authCookie}}

### Roles (admin → 200 with the role list)
GET {{host}}/api/admin/roles
Authorization: Bearer {{adminToken}}

### List users: no token (expect 401, empty body)
GET {{host}}/api/admin/users

### List users: regular user (expect 403, empty body)
GET {{host}}/api/admin/users
Authorization: Bearer {{userToken}}

### List users: admin (expect 200)
GET {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}

### Create walk-up (no email) → 201, status WalkUp
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Walk",
  "lastName": "Up"
}

### Create pending account with an extra role → 201, status PendingActivation
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Pending",
  "lastName": "Instructor",
  "email": "pending-{{$guid}}@test.com",
  "roles": ["ADMINISTRATOR"]
}

### Create with unknown role → 400
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Bad",
  "lastName": "Role",
  "roles": ["WIZARD"]
}

### Create with empty-string email → 400 (validation)
POST {{host}}/api/admin/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Empty",
  "lastName": "Email",
  "email": ""
}

### Get one user: unknown id → 404
GET {{host}}/api/admin/users/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{adminToken}}

### Edit walk-up: rename + new salutation/modifier → 200, displayName rebuilt
PUT {{host}}/api/admin/users/{{walkUpId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Robin",
  "lastName": "Walker",
  "salutation": "Sir",
  "modifier": "TheValiant",
  "email": null,
  "roles": ["REGULAR_USER"]
}

### Attach email to walk-up → 200, status PendingActivation
PUT {{host}}/api/admin/users/{{walkUpId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Robin",
  "lastName": "Walker",
  "salutation": "Sir",
  "modifier": "TheValiant",
  "email": "robin-{{$guid}}@test.com",
  "roles": ["REGULAR_USER"]
}

### Try to change the now-attached email → 400
PUT {{host}}/api/admin/users/{{walkUpId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Robin",
  "lastName": "Walker",
  "salutation": "Sir",
  "modifier": "TheValiant",
  "email": "different@test.com",
  "roles": ["REGULAR_USER"]
}

### Remove your OWN admin role → 400
PUT {{host}}/api/admin/users/{{adminId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Admin",
  "lastName": "User",
  "salutation": "Knight",
  "modifier": "TheBrave",
  "email": "PASTE_ADMIN_EMAIL",
  "roles": ["REGULAR_USER"]
}

### Missing salutation → 400 (validation)
PUT {{host}}/api/admin/users/{{pendingId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "Pending",
  "lastName": "Instructor",
  "modifier": "TheBrave",
  "email": "PASTE_PENDING_EMAIL",
  "roles": ["REGULAR_USER"]
}

### Unknown user → 404
PUT {{host}}/api/admin/users/00000000-0000-0000-0000-000000000001
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "firstName": "No",
  "lastName": "One",
  "salutation": "Knight",
  "modifier": "TheBrave",
  "roles": []
}

### Regular user tries to edit → 403
PUT {{host}}/api/admin/users/{{walkUpId}}
Authorization: Bearer {{userToken}}
Content-Type: application/json

{
  "firstName": "Hack",
  "lastName": "Attempt",
  "salutation": "Knight",
  "modifier": "TheBrave",
  "roles": ["ADMINISTRATOR"]
}
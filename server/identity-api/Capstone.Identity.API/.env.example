# Copy this file to a new file named .env (same folder) and fill in every value.
# .env is git-ignored. Never commit real values.

# Password for the local SQL Server 'sa' account.
# Rules: 8+ characters, using 3 of: uppercase, lowercase, digits, symbols.
# Avoid $ and ; characters (see the notes in the README).
SA_PASSWORD=CHANGE_ME

# JWT signing key, at least 32 characters. Generate one with either:
#   openssl rand -base64 64
#   PowerShell: [Convert]::ToBase64String([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(64))
JWT_KEY=CHANGE_ME

# Admin account created on first startup.
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=CHANGE_ME